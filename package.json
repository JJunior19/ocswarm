{
  "name": "ocswarm",
  "version": "0.1.0",
  "description": "Live mission control for OpenCode subagents",
  "license": "MIT",
  "author": "JJunior19",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JJunior19/ocswarm.git"
  },
  "homepage": "https://github.com/JJunior19/ocswarm#readme",
  "keywords": [
    "opencode",
    "plugin",
    "swarm",
    "subagents",
    "dashboard",
    "tui",
    "mission-control"
  ],
  "files": [
    "src",
    "dist/web",
    "README.md",
    "LICENSE",
    "!**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build src/web",
    "lint": "biome check src scripts",
    "format": "biome check --write src scripts",
    "prepublishOnly": "bun run test && bun run typecheck && bun run build:web"
  },
  "dependencies": {
    "@opencode/plugin": "latest",
    "d3-force": "^3.0.0",
    "framer-motion": "^12.0.0",
    "hono": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@opencode/client": "latest",
    "@types/d3-force": "^3.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  }
}
